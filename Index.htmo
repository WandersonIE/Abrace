<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abrace Vendas - Sistema de Gestão</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }
        .bg-capadocia-card {
            background-color: #1e1b4b;
            border: 1px solid #312e81;
        }
        .bg-capadocia-accent {
            background-color: #4c1d95;
        }
        .bg-capadocia-accent:hover {
            background-color: #5b21b6;
        }
        .text-capadocia-glow {
            color: #c084fc;
        }
    </style>
</head>
<body class="min-h-screen pb-12">

    <!-- CABEÇALHO -->
    <header class="bg-indigo-950 border-b border-indigo-900 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-purple-600 p-2.5 rounded-xl shadow-inner">
                    <i class="fa-solid fa-[#000] fa-shop text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold tracking-wider text-purple-300">ABRACE VENDAS</h1>
                    <p class="text-xs text-indigo-300">Gestão de Estoque, Vendas e Comissões</p>
                </div>
            </div>
            <button onclick="abrirModalPDV()" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2.5 px-5 rounded-xl shadow-lg flex items-center gap-2 transition duration-200">
                <i class="fa-solid fa-cart-plus"></i> Nova Venda (PDV)
            </button>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-6 space-y-8">

        <!-- DASHBOARD DE METRICAS -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-capadocia-card p-5 rounded-2xl shadow-md">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-semibold text-indigo-300 uppercase tracking-wider">Faturamento Total</p>
                        <h3 id="kpi-faturamento" class="text-2xl font-bold text-emerald-400 mt-1">R$ 0,00</h3>
                    </div>
                    <div class="p-3 bg-emerald-950 text-emerald-400 rounded-xl">
                        <i class="fa-solid fa-sack-dollar text-lg"></i>
                    </div>
                </div>
            </div>

            <div class="bg-capadocia-card p-5 rounded-2xl shadow-md">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-semibold text-indigo-300 uppercase tracking-wider">Lucro Líquido</p>
                        <h3 id="kpi-lucro" class="text-2xl font-bold text-purple-300 mt-1">R$ 0,00</h3>
                    </div>
                    <div class="p-3 bg-purple-950 text-purple-400 rounded-xl">
                        <i class="fa-solid fa-chart-line text-lg"></i>
                    </div>
                </div>
            </div>

            <div class="bg-capadocia-card p-5 rounded-2xl shadow-md">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-semibold text-indigo-300 uppercase tracking-wider">Comissões Pagas</p>
                        <h3 id="kpi-comissoes" class="text-2xl font-bold text-amber-400 mt-1">R$ 0,00</h3>
                    </div>
                    <div class="p-3 bg-amber-950 text-amber-400 rounded-xl">
                        <i class="fa-solid fa-hand-holding-dollar text-lg"></i>
                    </div>
                </div>
            </div>

            <div class="bg-capadocia-card p-5 rounded-2xl shadow-md">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-semibold text-indigo-300 uppercase tracking-wider">Total em Estoque</p>
                        <h3 id="kpi-estoque" class="text-2xl font-bold text-blue-400 mt-1">0 un.</h3>
                    </div>
                    <div class="p-3 bg-blue-950 text-blue-400 rounded-xl">
                        <i class="fa-solid fa-boxes-stacked text-lg"></i>
                    </div>
                </div>
            </div>
        </section>

        <!-- SEÇÕES DE GESTÃO -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- PRODUTOS E ESTOQUE -->
            <section class="lg:col-span-2 bg-capadocia-card p-6 rounded-2xl shadow-md space-y-4">
                <div class="flex justify-between items-center pb-3 border-b border-indigo-900">
                    <h2 class="text-lg font-bold text-purple-200 flex items-center gap-2">
                        <i class="fa-solid fa-box text-purple-400"></i> Gestão de Produtos
                    </h2>
                    <button onclick="abrirModalProduto()" class="bg-indigo-700 hover:bg-indigo-600 text-white text-sm font-semibold py-1.5 px-3 rounded-lg flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-plus"></i> Novo Produto
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-indigo-100">
                        <thead class="bg-indigo-950/70 text-indigo-300 uppercase text-xs">
                            <tr>
                                <th class="p-3">Produto</th>
                                <th class="p-3">Custo</th>
                                <th class="p-3">Venda</th>
                                <th class="p-3">Estoque</th>
                                <th class="p-3 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="tabela-produtos" class="divide-y divide-indigo-900/50">
                            <!-- Preenchido via JS -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- VENDEDORES E COMISSÕES -->
            <section class="bg-capadocia-card p-6 rounded-2xl shadow-md space-y-4">
                <div class="flex justify-between items-center pb-3 border-b border-indigo-900">
                    <h2 class="text-lg font-bold text-purple-200 flex items-center gap-2">
                        <i class="fa-solid fa-users text-purple-400"></i> Vendedores
                    </h2>
                    <button onclick="abrirModalVendedor()" class="bg-indigo-700 hover:bg-indigo-600 text-white text-sm font-semibold py-1.5 px-3 rounded-lg flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-user-plus"></i> Cadastrar
                    </button>
                </div>

                <div id="lista-vendedores" class="space-y-3">
                    <!-- Preenchido via JS -->
                </div>
            </section>

        </div>

        <!-- HISTÓRICO DE VENDAS -->
        <section class="bg-capadocia-card p-6 rounded-2xl shadow-md space-y-4">
            <div class="flex justify-between items-center pb-3 border-b border-indigo-900">
                <h2 class="text-lg font-bold text-purple-200 flex items-center gap-2">
                    <i class="fa-solid fa-receipt text-purple-400"></i> Histórico de Vendas
                </h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-indigo-100">
                    <thead class="bg-indigo-950/70 text-indigo-300 uppercase text-xs">
                        <tr>
                            <th class="p-3">Data</th>
                            <th class="p-3">Produto</th>
                            <th class="p-3">Qtd</th>
                            <th class="p-3">Vendedor</th>
                            <th class="p-3">Total</th>
                            <th class="p-3">Comissão</th>
                            <th class="p-3">Lucro</th>
                            <th class="p-3 text-right">Ação</th>
                        </tr>
                    </thead>
                    <tbody id="tabela-vendas" class="divide-y divide-indigo-900/50">
                        <!-- Preenchido via JS -->
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- MODAL NOVO PRODUTO -->
    <div id="modal-produto" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden flex justify-center items-center p-4 z-50">
        <div class="bg-indigo-950 border border-indigo-800 rounded-2xl p-6 w-full max-w-md space-y-4 shadow-2xl">
            <h3 class="text-xl font-bold text-purple-200">Cadastrar Produto</h3>
            <form id="form-produto" onsubmit="salvarProduto(event)" class="space-y-3">
                <div>
                    <label class="text-xs text-indigo-300">Nome do Produto</label>
                    <input type="text" id="prod-nome" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-indigo-300">Preço Custo (R$)</label>
                        <input type="number" step="0.01" id="prod-custo" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                    </div>
                    <div>
                        <label class="text-xs text-indigo-300">Preço Venda (R$)</label>
                        <input type="number" step="0.01" id="prod-venda" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                    </div>
                </div>
                <div>
                    <label class="text-xs text-indigo-300">Quantidade Inicial em Estoque</label>
                    <input type="number" id="prod-estoque" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="fecharModais()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-indigo-200 rounded-xl">Cancelar</button>
                    <button type="submit" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-xl">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL NOVO VENDEDOR -->
    <div id="modal-vendedor" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden flex justify-center items-center p-4 z-50">
        <div class="bg-indigo-950 border border-indigo-800 rounded-2xl p-6 w-full max-w-md space-y-4 shadow-2xl">
            <h3 class="text-xl font-bold text-purple-200">Cadastrar Vendedor</h3>
            <form id="form-vendedor" onsubmit="salvarVendedor(event)" class="space-y-3">
                <div>
                    <label class="text-xs text-indigo-300">Nome do Vendedor</label>
                    <input type="text" id="vend-nome" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                </div>
                <div>
                    <label class="text-xs text-indigo-300">Taxa de Comissão (%)</label>
                    <input type="number" step="0.1" id="vend-comissao" value="5" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="fecharModais()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-indigo-200 rounded-xl">Cancelar</button>
                    <button type="submit" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-xl">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL REGISTRAR VENDA (PDV) -->
    <div id="modal-pdv" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden flex justify-center items-center p-4 z-50">
        <div class="bg-indigo-950 border border-indigo-800 rounded-2xl p-6 w-full max-w-md space-y-4 shadow-2xl">
            <h3 class="text-xl font-bold text-purple-200 flex items-center gap-2">
                <i class="fa-solid fa-cart-shopping text-purple-400"></i> Registrar Venda
            </h3>
            <form id="form-pdv" onsubmit="realizarVenda(event)" class="space-y-3">
                <div>
                    <label class="text-xs text-indigo-300">Selecione o Produto</label>
                    <select id="pdv-produto" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-indigo-300">Quantidade</label>
                        <input type="number" id="pdv-qtd" value="1" min="1" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                    </div>
                    <div>
                        <label class="text-xs text-indigo-300">Vendedor</label>
                        <select id="pdv-vendedor" required class="w-full bg-slate-900 border border-indigo-800 rounded-xl p-2.5 text-white mt-1 focus:outline-none focus:border-purple-500">
                        </select>
                    </div>
                </div>

                <div class="bg-indigo-900/50 p-3 rounded-xl space-y-1 text-xs text-indigo-200 border border-indigo-800">
                    <div class="flex justify-between"><span>Subtotal:</span> <span id="pdv-preview-total" class="font-bold text-white">R$ 0,00</span></div>
                    <div class="flex justify-between"><span>Comissão estimada:</span> <span id="pdv-preview-comissao" class="text-amber-400">R$ 0,00</span></div>
                    <div class="flex justify-between"><span>Lucro estimado:</span> <span id="pdv-preview-lucro" class="text-emerald-400 font-bold">R$ 0,00</span></div>
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="fecharModais()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-indigo-200 rounded-xl">Cancelar</button>
                    <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl">Finalizar Venda</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // ESTADO DA APLICAÇÃO (LOCALSTORAGE)
        let produtos = JSON.parse(localStorage.getItem('abrace_produtos')) || [
            { id: 1, nome: 'Café Capadócia 500g', custo: 12.00, venda: 25.00, estoque: 40 },
            { id: 2, nome: 'Caneca Abrace Vendas', custo: 8.50, venda: 20.00, estoque: 15 }
        ];

        let vendedores = JSON.parse(localStorage.getItem('abrace_vendedores')) || [
            { id: 1, nome: 'Vendedor Padrão', comissao: 5.0 }
        ];

        let vendas = JSON.parse(localStorage.getItem('abrace_vendas')) || [];

        function salvarDados() {
            localStorage.setItem('abrace_produtos', JSON.stringify(produtos));
            localStorage.setItem('abrace_vendedores', JSON.stringify(vendedores));
            localStorage.setItem('abrace_vendas', JSON.stringify(vendas));
            renderizar();
        }

        const formatarMoeda = (val) => val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        function renderizar() {
            // RENDER PRODUTOS
            const tbProdutos = document.getElementById('tabela-produtos');
            tbProdutos.innerHTML = produtos.map(p => `
                <tr class="hover:bg-indigo-900/30">
                    <td class="p-3 font-semibold">${p.nome}</td>
                    <td class="p-3 text-indigo-300">${formatarMoeda(p.custo)}</td>
                    <td class="p-3 font-bold text-emerald-400">${formatarMoeda(p.venda)}</td>
                    <td class="p-3">
                        <span class="px-2 py-1 rounded-md text-xs font-bold ${p.estoque < 5 ? 'bg-rose-950 text-rose-400 border border-rose-800' : 'bg-slate-800 text-indigo-200'}">
                            ${p.estoque} un.
                        </span>
                    </td>
                    <td class="p-3 text-right">
                        <button onclick="excluirProduto(${p.id})" class="text-rose-400 hover:text-rose-300 p-1"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');

            // RENDER VENDEDORES
            const divVendedores = document.getElementById('lista-vendedores');
            divVendedores.innerHTML = vendedores.map(v => {
                const totalVendido = vendas.filter(vd => vd.vendedorId === v.id).reduce((acc, vd) => acc + vd.total, 0);
                const totalComissao = vendas.filter(vd => vd.vendedorId === v.id).reduce((acc, vd) => acc + vd.valorComissao, 0);
                return `
                    <div class="bg-indigo-950/60 p-3 rounded-xl border border-indigo-900 flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-purple-200">${v.nome}</h4>
                            <p class="text-xs text-indigo-400">Comissão: ${v.comissao}% | Vendas: ${formatarMoeda(totalVendido)}</p>
                        </div>
                        <div class="text-right">
                            <span class="text-xs text-indigo-300 block">A receber</span>
                            <span class="font-bold text-amber-400">${formatarMoeda(totalComissao)}</span>
                        </div>
                    </div>
                `;
            }).join('');

            // RENDER VENDAS
            const tbVendas = document.getElementById('tabela-vendas');
            tbVendas.innerHTML = vendas.map(v => `
                <tr class="hover:bg-indigo-900/30">
                    <td class="p-3 text-xs text-indigo-300">${v.data}</td>
                    <td class="p-3 font-semibold">${v.produtoNome}</td>
                    <td class="p-3">${v.qtd}</td>
                    <td class="p-3 text-indigo-300">${v.vendedorNome}</td>
                    <td class="p-3 font-bold text-emerald-400">${formatarMoeda(v.total)}</td>
                    <td class="p-3 text-amber-400">${formatarMoeda(v.valorComissao)}</td>
                    <td class="p-3 font-bold text-purple-300">${formatarMoeda(v.lucro)}</td>
                    <td class="p-3 text-right">
                        <button onclick="estornarVenda(${v.id})" title="Estornar" class="text-rose-400 hover:text-rose-300 text-xs bg-rose-950/50 p-1.5 rounded-lg border border-rose-900">
                            Estornar
                        </button>
                    </td>
                </tr>
            `).join('');

            // CALCULAR KPIS
            const fatTotal = vendas.red